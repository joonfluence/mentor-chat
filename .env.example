ANTHROPIC_API_KEY=
VAULT_WIKI_PATH=/Users/yijun/Obsidian Vault/llm-wiki/wiki

# LLM_PROVIDER=opencode로 바꾸면 Claude 대신 opencode Zen 게이트웨이 모델 사용 (기본값: anthropic)
LLM_PROVIDER=anthropic
# opencode Zen API 키 — opencode CLI에 이미 로그인했다면 ~/.local/share/opencode/auth.json 의 opencode.key 값
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
